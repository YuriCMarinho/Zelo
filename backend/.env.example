DATABASE_URL=postgresql://postgres:postgres@localhost:5433/smartrepair
ENVIRONMENT=development
LOG_LEVEL=INFO
LLM_MODE=mock
# mock | featherless | recorded_demo (reprodução local sem inferência externa)
RECORDED_DEMO_LATENCY_MS=80
FEATHERLESS_API_KEY=mock-key
LANGFUSE_PUBLIC_KEY=mock-public
LANGFUSE_SECRET_KEY=mock-secret
LANGFUSE_HOST=https://cloud.langfuse.com
MAX_COST_PER_RUN_USD=0.03
MAX_COST_GLOBAL_USD=25.00
PROVIDER_SOURCE=web_maps
GOOGLE_PLACES_API_KEY=
PROVIDER_CONTACT_ALLOWLIST=
PROVIDER_SIMULATED_REPLIES={}
PROVIDER_COLLECTION_HOURS=12
MAX_PLACES_CALLS=50
BUDGET_RESERVE_USD=7.50
BUDGET_RESERVE_UNLOCKED=false
